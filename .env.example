# ========================================================
# MICROSOFT EDGE REWARDS RPA - PLANTILLA DE CONFIGURACIÓN
# ========================================================
# Copia este archivo como .env y ajusta tus preferencias personales.
# El archivo .env NO se subirá a GitHub por seguridad.

# Rango de usuario: 'oro' (20 búsquedas) o 'plata' (10 búsquedas)
REWARDS_TIER=oro

# Cantidad de búsquedas según el rango
SEARCHES_ORO=20
SEARCHES_PLATA=10

# Perfil de Microsoft Edge a utilizar ('Default', 'Profile 1', 'Profile 2', etc.)
EDGE_PROFILE=Default

# Carpeta privada para las cookies y sesión local
USER_DATA_DIR=.edge_rewards_profile

# Pausas aleatorias entre búsquedas para evitar detección (milisegundos)
MIN_DELAY_MS=6000
MAX_DELAY_MS=12000

# Mostrar u ocultar el navegador (false = visible, true = invisible)
HEADLESS=false
